units           real
atom_style      full
bond_style      harmonic
angle_style     harmonic
dihedral_style  charmm
improper_style  umbrella
special_bonds   dreiding
# Coefficients in non-bonding are just as an example
pair_style      lj/cut/coul/long 10.0
kspace_style    ewald 0.0001
dielectric      1.0
